# MeBo — example environment file
# ===================================================================
# Copy this file to .env (git-ignored) and set only what you need.
# NEVER commit a real token, and never put one in a VITE_ variable:
#   - the BRIDGE (bridge/server.mjs) reads the plain variables below from its
#     environment or from .env. They stay on this machine.
#   - the BROWSER app gets ONLY VITE_-prefixed variables, and Vite builds them
#     into the public JavaScript bundle. Anyone can read them.


# ===================================================================
# MODEL — bridge only
# ===================================================================
# Which model answers: ollama (offline, local) or huggingface (online).
# Default: huggingface when HF_TOKEN is set, otherwise ollama.
# LLM_PROVIDER=ollama

# Online — Hugging Face Inference Providers. A fine-grained token with only
# the "Make calls to Inference Providers" permission (huggingface.co/settings/tokens).
# HF_TOKEN=
# HF_MODEL=google/gemma-4-26B-A4B-it
# HF_BASE_URL=https://router.huggingface.co/v1

# Offline — a local Ollama server (ollama pull gemma4:e4b). No credentials.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_NUM_CTX=16384

# Longest wait for one model call, in milliseconds (a cold local model is slow to load).
# LLM_TIMEOUT_MS=120000

# Model calls allowed per rolling hour — a cost and abuse guard for paid inference.
# LLM_MAX_CALLS_PER_HOUR=300

# Output tokens per model call (bounds the cost of each call).
# LLM_MAX_OUTPUT_TOKENS=800


# ===================================================================
# PUBLIC MODE — when MeBo is reachable by others (set by the Netlify entry)
# ===================================================================
# Each visitor gets a private crew memory (HttpOnly cookie) and these limits.
# See docs/deploy-netlify.md.
# MEBO_PUBLIC=0
# Durable copy of crew memory: netlify-blobs, or dir:<path> on a persistent disk.
# MEBO_DURABLE_MEMORY=
# MEBO_VISITOR_CALLS_PER_HOUR=40
# MEBO_VISITOR_WRITES_PER_HOUR=200
# MEBO_VISITOR_CONNECTIONS=2
# MEBO_MAX_CONNECTIONS=100
# MEBO_MAX_QUESTION_CHARS=1000
# Only for testing public mode over plain HTTP: do not mark the cookie Secure.
# MEBO_COOKIE_INSECURE=0


# ===================================================================
# BRIDGE — the local server (older JARVIS_* names are still read)
# ===================================================================
# Port for the WebSocket and HTTP endpoints. If you change it, change VITE_BRIDGE_URL too.
# MEBO_BRIDGE_PORT=8787

# Interface to listen on. Default 127.0.0.1 — this machine only. The bridge has
# no user authentication: do not expose it to a network without adding some.
# MEBO_BRIDGE_HOST=127.0.0.1

# Extra hostnames the bridge answers to, comma separated (DNS-rebinding guard).
# MEBO_ALLOWED_HOSTS=

# Extra page origins allowed to connect, comma separated. Default: local dev ports only.
# MEBO_ALLOWED_ORIGINS=

# Accept clients that send no Origin header (scripts). Default 0.
# MEBO_ALLOW_NO_ORIGIN=0

# Capabilities to leave out, comma separated: camera, medical.
# MEBO_DISABLE=

# Folder /file may serve images from (besides the temp folders). Default ~/.mebo/workspace.
# MEBO_WORKSPACE=
# MEBO_FILE_ROOTS=

# Log every model message. Default 0.
# MEBO_DEBUG=0

# Restart the bridge when its code changes (npm start). Default 1.
# MEBO_BRIDGE_WATCH=1

# Medical data and crew memory locations (defaults: data/medical/, memory/crew/ — both git-ignored).
# MEBO_MEDICAL_DB=
# MEBO_MEMORY_DIR=

# Optional premium cloud voice (ElevenLabs), proxied by the bridge; the browser never sees the key.
# ELEVENLABS_API_KEY=
# MEBO_VOICE_ID=JBFqnCBsd6RMkjVDRZzb


# ===================================================================
# BROWSER — VITE_ variables are public; never put a secret here
# ===================================================================
# Where the bridge is. same-origin = this site's own /ws (a hosted deploy).
# VITE_BRIDGE_URL=ws://localhost:8787

# Speech engine: piper (default, local neural voice), kokoro, or system.
# VITE_TTS_ENGINE=piper

# Piper speaking rate, 0.5 to 1.5 (lower is calmer). Tune live in the console:
# __mebo.voice.setRate(0.8) — the tuned value is remembered in that browser.
# VITE_PIPER_RATE=0.85

# Kokoro voice, when VITE_TTS_ENGINE=kokoro.
# VITE_KOKORO_VOICE=bm_george

# Use the bridge's ElevenLabs voice ahead of the local one (needs ELEVENLABS_API_KEY on the bridge).
# VITE_USE_ELEVENLABS=false

# Length of the camera check's natural-observation window, in seconds (20–180).
# VITE_ALERTNESS_WINDOW_S=60
